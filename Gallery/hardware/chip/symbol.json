{
  "schema_version": 1,
  "version": 2,
  "description": "A processor with individually editable pins and a labeled core.",
  "tags": [
    "ai",
    "processor",
    "cpu",
    "microchip",
    "pins",
    "AI chip"
  ],
  "order": 0,
  "defaults": {
    "fill": "#2878D4",
    "accent": "#74B9FF",
    "stroke": "#153E5B",
    "highlight": "#FFFFFF",
    "stroke_width": 5,
    "radius": 7,
    "pins": 6,
    "pin_length": 20,
    "pin_width": 7,
    "core_size": 102,
    "label": "AI",
    "font_size": 43
  },
  "controls": [
    {
      "key": "pins",
      "label": "Pins per side",
      "type": "number",
      "default": 6,
      "min": 2,
      "max": 16,
      "step": 1,
      "unit": ""
    },
    {
      "key": "pin_length",
      "label": "Pin length",
      "type": "number",
      "default": 20,
      "min": 6,
      "max": 30,
      "step": 1,
      "unit": "u"
    },
    {
      "key": "pin_width",
      "label": "Pin width",
      "type": "number",
      "default": 7,
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "u"
    },
    {
      "key": "core_size",
      "label": "Core size",
      "type": "number",
      "default": 102,
      "min": 58,
      "max": 142,
      "step": 1,
      "unit": "u"
    },
    {
      "key": "label",
      "label": "Core label",
      "type": "text",
      "default": "AI",
      "max_length": 12
    },
    {
      "key": "font_size",
      "label": "Label size",
      "type": "number",
      "default": 43,
      "min": 10,
      "max": 64,
      "step": 1,
      "unit": "u"
    }
  ]
}
